{
  "info": {
    "name": "Automation Exercise \u2014 QA Portfolio API contracts",
    "description": "Nine resume-aligned Postman cases. No authentication credentials or real account mutations are required. Run in collection order for the empty-search catalog comparison. Source: https://automationexercise.com/api_list.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "api_base_url",
      "value": "https://automationexercise.com/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('request_started_at_utc', new Date().toISOString());",
          "console.info(pm.info.requestName + ' started at ' + pm.variables.get('request_started_at_utc'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "TC-API-001 GET productsList",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_base_url}}/productsList",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "productsList"
          ]
        },
        "description": "GET /api/productsList \u2014 contract validation\nHTTP status and body responseCode are separate assertions. This demo currently serves JSON using a text/html Content-Type."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type header is present', () => pm.expect(pm.response.headers.get('Content-Type')).to.be.a('string').and.not.empty);",
              "const qaPortfolioPayload = pm.response.json();",
              "pm.test('Body responseCode is 200', () => pm.expect(qaPortfolioPayload.responseCode).to.eql(200));",
              "pm.test('Products are non-empty and well formed', () => { pm.expect(qaPortfolioPayload.products).to.be.an('array').and.not.empty; qaPortfolioPayload.products.forEach(p => { pm.expect(p.id).to.be.a('number'); ['name','price','brand'].forEach(k => pm.expect(p[k]).to.be.a('string').and.not.empty); pm.expect(p.category.category).to.be.a('string'); }); });",
              "pm.test('Blue Top fixture matches inspected data', () => { const p=qaPortfolioPayload.products.find(p => p.id===1); pm.expect(p).to.be.an('object'); pm.expect(p.name).to.eql('Blue Top'); pm.expect(p.price).to.eql('Rs. 500'); pm.expect(p.brand).to.eql('Polo'); });",
              "pm.collectionVariables.set('catalog_ids', JSON.stringify(qaPortfolioPayload.products.map(p => p.id).sort((a,b)=>a-b)));",
              "pm.test('Catalog IDs are unique', () => pm.expect(new Set(qaPortfolioPayload.products.map(p=>p.id)).size).to.eql(qaPortfolioPayload.products.length));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-API-002 POST productsList",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_base_url}}/productsList",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "productsList"
          ]
        },
        "description": "POST /api/productsList \u2014 contract validation\nHTTP status and body responseCode are separate assertions. This demo currently serves JSON using a text/html Content-Type.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": []
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type header is present', () => pm.expect(pm.response.headers.get('Content-Type')).to.be.a('string').and.not.empty);",
              "const qaPortfolioPayload = pm.response.json();",
              "pm.test('Body responseCode is 405', () => pm.expect(qaPortfolioPayload.responseCode).to.eql(405));",
              "pm.test('Exact validation message', () => pm.expect(qaPortfolioPayload.message).to.eql(\"This request method is not supported.\"));"
            ]
          }
        }
      ]
    },
