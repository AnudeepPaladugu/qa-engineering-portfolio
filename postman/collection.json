      "name": "TC-API-005 POST searchProduct",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_base_url}}/searchProduct",
